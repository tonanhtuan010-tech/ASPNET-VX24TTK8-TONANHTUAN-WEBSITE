@model AdminChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<h1 class="admin-title">Đổi mật khẩu</h1>
<div class="panel form-panel" style="max-width:600px">
  <form asp-controller="Admin" asp-action="ChangePassword" method="post" asp-antiforgery="true" autocomplete="off">
    <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

    <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
    <span asp-validation-for="CurrentPassword" class="field-error"></span>

    <label asp-for="NewPassword">Mật khẩu mới</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" maxlength="128" required />
    <span asp-validation-for="NewPassword" class="field-error"></span>

    <label asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
    <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" required />
    <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>

    <p class="hint">Mật khẩu mới cần có ít nhất 10 ký tự.</p>
    <div class="form-actions">
      <button class="btn-blue" type="submit">Lưu mật khẩu mới</button>
      <a asp-controller="Admin" asp-action="Index" class="btn-light">Quay lại</a>
    </div>
  </form>
</div>
