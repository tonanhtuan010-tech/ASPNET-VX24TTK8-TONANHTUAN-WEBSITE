@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<h1 class="admin-title">Đơn hàng #@Model.OrderID</h1>
<div class="panel"><h2>Thông tin khách hàng</h2><p><b>Ngày đặt:</b> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p><p><b>Họ tên:</b> @Model.CustomerName</p><p><b>Số điện thoại:</b> @Model.Phone</p><p><b>Địa chỉ:</b> @Model.Address</p><p><b>Ghi chú:</b> @Model.Note</p><p><b>Trạng thái:</b> @Model.Status</p><p><b>Thanh toán:</b> @PaymentDisplay.Method(Model.PaymentMethod) (@PaymentDisplay.Status(Model.PaymentStatus))</p><hr/>
<h2>Sản phẩm đã đặt</h2><table class="data-table"><thead><tr><th>Tên sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>
@foreach (var d in Model.OrderDetails) { <tr><td>@d.Product?.Name</td><td>@d.Quantity</td><td>@d.UnitPrice.ToString("N0") đ</td><td>@((d.UnitPrice * d.Quantity).ToString("N0")) đ</td></tr> }</tbody></table><p class="sum-right">Tổng: <strong>@Model.TotalAmount.ToString("N0") đ</strong></p>
<a class="btn-light" asp-action="Orders">Quay lại</a></div>
