@model User
@{ ViewData["Title"] = "Sửa thành viên"; }
<h1 class="admin-title">Sửa thông tin thành viên</h1>
<div class="panel form-panel">
    <form asp-action="EditUser" asp-route-id="@Model.UserID" method="post">
        <div asp-validation-summary="ModelOnly" class="field-error"></div>
        <div class="form-grid">
            <div><label>Họ tên</label><input name="fullName" value="@Model.FullName" required maxlength="100" /></div>
            <div><label>Email</label><input type="email" name="email" value="@Model.Email" required maxlength="150" /></div>
            <div><label>Số điện thoại</label><input name="phone" value="@Model.PhoneNumber" maxlength="20" /></div>
            <div><label>Vai trò</label><input value="@Model.Role" disabled /></div>
            <div class="full-col"><label>Địa chỉ</label><input name="address" value="@Model.Address" maxlength="300" /></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn-blue">Lưu</button><a asp-action="Users" class="btn-light">Quay lại</a></div>
    </form>
</div>
