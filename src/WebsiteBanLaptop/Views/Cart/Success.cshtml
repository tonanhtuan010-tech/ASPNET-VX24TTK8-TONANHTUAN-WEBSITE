@model Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }
<div class="success-box"><div class="big-check"><i class="bi bi-check-lg" aria-hidden="true"></i></div><h1>Đặt hàng thành công!</h1><p>Đơn hàng <b>#@Model.OrderID</b> của bạn đã được ghi nhận.</p><p>Tổng tiền: <strong>@Model.TotalAmount.ToString("N0") đ</strong></p><p>Hình thức thanh toán: @PaymentDisplay.Method(Model.PaymentMethod)</p><div class="form-actions"><a class="btn-red" asp-controller="Account" asp-action="Orders">Xem đơn hàng</a><a class="btn-light" asp-controller="Home" asp-action="Index">Tiếp tục mua hàng</a></div></div>
