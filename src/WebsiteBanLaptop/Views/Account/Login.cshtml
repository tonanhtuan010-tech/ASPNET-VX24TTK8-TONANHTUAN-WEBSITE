@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="breadcrumbs">Trang chủ / Đăng nhập</div>
<div class="auth-box"><h1>ĐĂNG NHẬP</h1>
<p>@(Model.ReturnUrl?.StartsWith("/Cart/Checkout", StringComparison.OrdinalIgnoreCase) == true
    ? "Vui lòng đăng nhập để tiếp tục thanh toán"
    : "Đăng nhập để xem tài khoản và đơn hàng")</p>
<form asp-action="Login" method="post">
 <input type="hidden" asp-for="ReturnUrl" />
 <div asp-validation-summary="ModelOnly" class="field-error"></div>
 <label>Email</label><input asp-for="Email" type="email" placeholder="Nhập email" /><span asp-validation-for="Email" class="field-error"></span>
 <label>Mật khẩu</label><input asp-for="Password" type="password" placeholder="Nhập mật khẩu" /><span asp-validation-for="Password" class="field-error"></span>
 <button type="submit">Đăng nhập</button>
</form><p>Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p></div>
