@model List<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<h1 class="page-title">Đơn hàng của tôi</h1>
<div class="table-panel"><table class="data-table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thanh toán</th><th></th></tr></thead>
<tbody>@foreach (var o in Model) { <tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td><td class="price-text">@o.TotalAmount.ToString("N0") đ</td><td>@o.Status</td><td>@PaymentDisplay.Method(o.PaymentMethod) / @PaymentDisplay.Status(o.PaymentStatus)</td><td><a asp-action="OrderDetails" asp-route-id="@o.OrderID">Chi tiết</a></td></tr> }</tbody></table>
@if (!Model.Any()) { <div class="empty-box">Bạn chưa có đơn hàng.</div> }</div>
