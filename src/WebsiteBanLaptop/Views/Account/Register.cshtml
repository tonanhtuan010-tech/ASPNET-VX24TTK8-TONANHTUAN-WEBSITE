@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="breadcrumbs">Trang chủ / Đăng ký</div>
<div class="auth-box"><h1>ĐĂNG KÝ</h1><p>Tạo tài khoản để mua laptop</p>
<form asp-action="Register" method="post">
  <div asp-validation-summary="ModelOnly" class="field-error"></div>
  <label>Họ tên</label><input asp-for="FullName" placeholder="Họ và tên" /><span asp-validation-for="FullName" class="field-error"></span>
  <label>Email</label><input asp-for="Email" type="email" placeholder="Email của bạn" /><span asp-validation-for="Email" class="field-error"></span>
  <label>Mật khẩu</label><input asp-for="Password" type="password" placeholder="Ít nhất 6 ký tự" /><span asp-validation-for="Password" class="field-error"></span>
  <label>Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" type="password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span>
  <button type="submit">Đăng ký</button>
</form><p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div>
