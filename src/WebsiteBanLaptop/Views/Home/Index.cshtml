@model List<Product>
@{ ViewData["Title"] = "Trang chủ"; ViewData["FilterAction"] = "Index"; }
<div class="breadcrumbs">Trang chủ</div>
<div class="hero-banner">
  <div>
    <span class="hero-eyebrow">LAPTOP CHO MỌI NHU CẦU</span>
    <h1>Chọn laptop phù hợp<br />với bạn</h1>
    <p>Laptop học tập, làm việc và chơi game với nhiều mức giá khác nhau.</p>
    <a href="#san-pham" class="hero-action">Xem các mẫu laptop <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
  </div>
  <img src="/images/laptop-hero.svg" alt="Laptop" onerror="this.onerror=null;this.src='/images/laptop-default.svg'" />
</div>
<div class="benefits"><span><i class="bi bi-cpu" aria-hidden="true"></i> Lọc theo hãng, giá, CPU và RAM</span><span><i class="bi bi-laptop" aria-hidden="true"></i> Xem đủ cấu hình từng máy</span><span><i class="bi bi-truck" aria-hidden="true"></i> Thanh toán khi nhận hàng</span></div>
<section class="products-section" id="san-pham">
  <div class="section-title"><h2>Danh sách laptop</h2><span>@Model.Count sản phẩm</span></div>
  <partial name="_LaptopFilters" />
  <p class="result-count">Có <strong>@Model.Count</strong> sản phẩm phù hợp</p>
  @if (!Model.Any()) { <div class="empty-box">Không có laptop phù hợp. <a asp-action="Index">Xóa lọc</a></div> }
  else { <div class="product-grid">@foreach (var product in Model) { <partial name="_ProductCard" model="product" /> }</div> }
</section>
