<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Quản trị</title>
  <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-page">
  <aside class="admin-side">
    <a class="admin-brand" asp-controller="Admin" asp-action="Index">Xin chào,<br /><strong>Quản trị viên</strong></a>
    <div class="admin-menu-title">QUẢN LÝ WEBSITE</div>
    <a asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2" aria-hidden="true"></i> Tổng quan</a>
    <a asp-controller="Admin" asp-action="Products"><i class="bi bi-laptop" aria-hidden="true"></i> Quản lý sản phẩm</a>
    <a asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags" aria-hidden="true"></i> Danh mục laptop</a>
    <a asp-controller="Admin" asp-action="Users"><i class="bi bi-people" aria-hidden="true"></i> Quản lý thành viên</a>
    <a asp-controller="Admin" asp-action="News"><i class="bi bi-newspaper" aria-hidden="true"></i> Quản lý tin tức</a>
    <a asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt" aria-hidden="true"></i> Quản lý đơn hàng</a>
    <a asp-controller="Admin" asp-action="Tasks"><i class="bi bi-list-check" aria-hidden="true"></i> Giao việc</a>
    <a asp-controller="Admin" asp-action="Stock"><i class="bi bi-box-seam" aria-hidden="true"></i> Tồn kho</a>
    <a asp-controller="Admin" asp-action="Revenue"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Doanh thu</a>
    <div class="side-bottom">
      <a asp-controller="Admin" asp-action="ChangePassword">Đổi mật khẩu</a>
      <a asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left" aria-hidden="true"></i> Về trang bán hàng</a>
      <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form>
    </div>
  </aside>
  <div class="admin-content">
    <header class="admin-top"><span>QUẢN TRỊ WEBSITE BÁN LAPTOP</span><span>@User.Identity?.Name</span></header>
    <main class="admin-main">
      @if (TempData["Ok"] != null) { <div class="alert good">@TempData["Ok"]</div> }
      @if (TempData["Error"] != null) { <div class="alert bad">@TempData["Error"]</div> }
      @RenderBody()
    </main>
  </div>
  <script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
