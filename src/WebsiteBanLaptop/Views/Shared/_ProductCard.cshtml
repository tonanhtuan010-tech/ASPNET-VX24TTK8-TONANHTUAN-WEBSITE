@model Product
<article class="product-card">
  <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductID" class="product-image">
    <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/laptop-default.svg'" />
  </a>
  <div class="product-info">
    <span class="product-tag">@Model.Category?.CategoryName</span>
    <a class="product-name" asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductID">@Model.Name</a>
    <div class="product-spec">@Model.Cpu · @Model.Ram · @Model.Storage</div>
    <div class="product-price">@Model.Price.ToString("N0") đ</div>
    <div class="card-bottom">
      <span class="stock @(Model.Stock > 0 ? "" : "soldout")">@(Model.Stock > 0 ? "Còn hàng" : "Hết hàng")</span>
    </div>
  </div>
</article>
