<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - Laptop Store</title>
  <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@inject WebsiteBanLaptop.Services.CategoryMenuService CategoryMenu
@{
  var menuCategories = await CategoryMenu.GetAsync();
}
<body>
  <header class="site-header">
    <div class="wrap head-row">
      <a class="logo" asp-controller="Home" asp-action="Index"><span class="logo-mark"><i class="bi bi-laptop" aria-hidden="true"></i></span> LAPTOP <b>STORE</b></a>
      <form class="search-header" asp-controller="Home" asp-action="Index" method="get">
        <input name="search" value="@ViewBag.Search" placeholder="Bạn cần tìm laptop gì?" aria-label="Tìm sản phẩm" />
        <button type="submit">Tìm kiếm</button>
      </form>
      <div class="head-links">
        @if (User.Identity?.IsAuthenticated == true)
        {
          <a asp-controller="Account" asp-action="Profile"><i class="bi bi-person" aria-hidden="true"></i> Tài khoản</a>
          <a asp-controller="Account" asp-action="Orders">Đơn hàng</a>
          <form asp-controller="Account" asp-action="Logout" method="post" class="logout-inline"><button type="submit">Đăng xuất</button></form>
        }
        else { <a asp-controller="Account" asp-action="Login"><i class="bi bi-person" aria-hidden="true"></i> Đăng nhập</a> }
        <a asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3" aria-hidden="true"></i> Giỏ hàng <span class="cart-badge">@WebsiteBanLaptop.Data.CartStore.Get(Context.Session).Sum(c => c.Quantity)</span></a>
      </div>
    </div>
  </header>
  <nav class="nav-line">
    <div class="wrap nav-inner">
      <button id="category-toggle" class="nav-strong" type="button" aria-controls="category-menu" aria-expanded="false"><i class="bi bi-list" aria-hidden="true"></i> DANH MỤC LAPTOP <i class="bi bi-chevron-down" aria-hidden="true"></i></button>
      <a asp-controller="Home" asp-action="Index">Trang chủ</a>
      <a asp-controller="Home" asp-action="Index" asp-route-sort="low">Laptop giá tốt</a>
      <a asp-controller="News" asp-action="Index">Tin tức</a>
    </div>
  </nav>
  <section class="mega-shell" id="category-menu" hidden aria-label="Danh mục laptop">
    <div class="wrap mega-grid">
      <div class="mega-left"><h3>Danh mục laptop</h3>
        <a asp-controller="Home" asp-action="Index"><i class="bi bi-grid" aria-hidden="true"></i> Tất cả laptop</a>
        @foreach (var item in menuCategories)
        {
          <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@item.CategoryID"><i class="bi bi-chevron-right" aria-hidden="true"></i> Laptop @item.CategoryName</a>
        }
      </div>
      <div class="mega-center"><h3>Gợi ý chọn laptop</h3>
        <p class="mega-subtitle">Lựa chọn theo hãng</p>
        <div class="mega-brand-list">
        @foreach (var item in menuCategories)
        {
          <a class="mega-link" asp-controller="Home" asp-action="Index" asp-route-categoryId="@item.CategoryID">@item.CategoryName</a>
        }
        </div>
        <p class="mega-subtitle">Theo nhu cầu sử dụng</p>
        <div class="mega-row-links"><a asp-controller="Home" asp-action="Index" asp-route-usage="study">Học tập</a><a asp-controller="Home" asp-action="Index" asp-route-usage="office">Văn phòng</a><a asp-controller="Home" asp-action="Index" asp-route-usage="gaming">Gaming</a></div>
        <p class="mega-subtitle">Theo khoảng giá</p>
        <div class="mega-row-links"><a asp-controller="Home" asp-action="Index" asp-route-priceRange="under20">Dưới 20 triệu</a><a asp-controller="Home" asp-action="Index" asp-route-priceRange="20-25">20–25 triệu</a><a asp-controller="Home" asp-action="Index" asp-route-priceRange="25-30">25–30 triệu</a><a asp-controller="Home" asp-action="Index" asp-route-priceRange="30-40">30–40 triệu</a><a asp-controller="Home" asp-action="Index" asp-route-priceRange="over40">Trên 40 triệu</a></div>
      </div>
      <div class="mega-right"><h3>Khám phá thêm</h3>
        <a asp-controller="Home" asp-action="Index" asp-route-sort="low"><i class="bi bi-tag" aria-hidden="true"></i> Laptop giá tốt</a>
        <a asp-controller="Home" asp-action="Index" asp-route-sort="high"><i class="bi bi-gem" aria-hidden="true"></i> Laptop cao cấp</a>
        <a asp-controller="Home" asp-action="Index" asp-route-usage="gaming"><i class="bi bi-controller" aria-hidden="true"></i> Laptop gaming</a>
        <a asp-controller="Cart" asp-action="Index"><i class="bi bi-cart3" aria-hidden="true"></i> Xem giỏ hàng</a>
      </div>
    </div>
  </section>
  <main class="wrap page-main">
    @if (TempData["Ok"] != null) { <div class="alert good">@TempData["Ok"]</div> }
    @if (TempData["Error"] != null) { <div class="alert bad">@TempData["Error"]</div> }
    @RenderBody()
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div><h3>LAPTOP STORE</h3><p>Website bán laptop</p></div>
      <div><b>Thông tin</b><p><a asp-controller="Home" asp-action="Index">Sản phẩm</a></p><p><a asp-controller="News" asp-action="Index">Tin tức</a></p></div>
    </div>
  </footer>
  <script>
    const categoryButton = document.getElementById('category-toggle');
    const categoryMenu = document.getElementById('category-menu');
    categoryButton?.addEventListener('click', () => {
      categoryMenu.hidden = !categoryMenu.hidden;
      categoryButton.setAttribute('aria-expanded', String(!categoryMenu.hidden));
    });
    document.addEventListener('click', e => {
      if (!categoryMenu.hidden && !e.target.closest('#category-menu') && !e.target.closest('#category-toggle')) {
        categoryMenu.hidden = true;
        categoryButton.setAttribute('aria-expanded', 'false');
      }
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !categoryMenu.hidden) {
        categoryMenu.hidden = true;
        categoryButton.setAttribute('aria-expanded', 'false');
        categoryButton.focus();
      }
    });
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
